<div id="images-view">

<%# directories (shown as regular rows, same as _files.erb) %>
    <% has_dirs  = file_tree.any? { |b| !b.is_a?(String) } %>
    <% has_files = file_tree.any? { |b| b.is_a?(String) } %>

    <% if key.size > 0 && !is_jailed || has_dirs %>
        <table id="files" class="dirs-table">
            <tbody>
<%# parent directory row %>
                <% if key.size > 0 && !is_jailed %>
                    <tr>
                        <td class="col-name">
                            <a class="file-link" href="<%= path_url('view', key[0..-2]) %>">
                                <span class="file-icon">&#128193;</span>
                                <span>..</span>
                            </a>
                        </td>
                        <td class="col-action"></td>
                    </tr>
                <% end %>
<%# directories %>
                <% file_tree.each do |branch| %>
                    <% next if branch.is_a?(String) %>
                    <% name = branch.keys[0] %>
                    <tr>
                        <td class="col-name">
                            <a class="file-link" href="<%= path_url('view', key + [name]) %>">
                                <span class="file-icon">&#128193;</span>
                                <span><%= h name %></span>
                            </a>
                        </td>
                        <td class="col-action"></td>
                    </tr>
                <% end %>

            </tbody>
        </table>
    <% end %>

<%# image grid %>
    <% if has_files %>
        <div class="image-grid">
            <% file_tree.each do |branch| %>
                <% next unless branch.is_a?(String) %>
                <%
                all_segments = key + [branch]
                size_label   = file_size_label(all_segments)
                info_args    = [path_url('info', all_segments), branch, size_label, all_segments.join('/')]
                                 .map { |a| h(a.to_json) }.join(', ')
                %>
                <div class="image-card">
                    <a class="image-thumb-link" href="<%= path_url('download', all_segments) %>">
                        <img class="image-thumb" src="<%= path_url('preview', all_segments) %>" alt="<%= h branch %>" loading="lazy"
                             onerror="this.replaceWith(fallbackIcon())">
                    </a>
                    <div class="image-card-footer">
                        <span class="image-name" title="<%= h branch %>"><%= h branch %></span>
                        <div class="image-actions">
                            <% unless read_only %>
                                <button class="icon-btn" onclick="showInfo(<%= info_args %>)" title="Properties">&#9432;</button>
                            <% end %>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
    <% end %>

    <% if file_tree.empty? && (key.size == 0 || is_jailed) %>
        <div style="padding: var(--padding); text-align: center;">No files yet</div>
    <% end %>

</div>

<script>
    function fallbackIcon() {
        const el = document.createElement('div')
        el.style.cssText = 'width:100%;height:100%;display:flex;align-items:center;justify-content:center;'
        el.textContent = '🖼️'
        return el
    }
</script>