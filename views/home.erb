<!DOCTYPE html>
<html>
<%= erb :_head %>
<body>
    <div id="page">
        <section>
            <%= erb :_toolbar, locals: { classes: 'mb', key: key, read_only: read_only } %>
            <div class="file-table-wrap">
                <%= erb :_images, locals: { file_tree: file_tree, key: key, is_jailed: is_jailed, read_only: read_only } %>
            </div>
        </section>

        <%= erb :_modal_base %>
        <%= erb :_file_info_modal %>
        <%= erb :_upload_modal, locals: { key: key } %>
        <%= erb :_new_folder_modal, locals: { key: key } %>
        <%= erb :_move_modal, locals: { key: key, all_dirs: all_dirs } %>
    </div>
</body>
</html>
