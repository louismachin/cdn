<!DOCTYPE html>
<html>
<%= erb :_head %>
<body class="centered">
    <section>
        <div class="column gap">
            <input id="username" placeholder="Username" autocomplete="username">
            <input id="password" placeholder="Password" type="password" autocomplete="current-password">
        </div>
        <div id="login-error" class="mt" style="color: var(--bad);"></div>
        <div class="buttons mt">
            <button class="blink" onclick="window.location = '/help'">Help</button>
            <button class="glink" onclick="submitAttempt()">Log in</button>
        </div>
    </section>
</body>

<script>
    document.getElementById('password').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') submitAttempt()
    })

    let submitAttempt = () => {
        const username = document.getElementById('username').value
        const password = document.getElementById('password').value
        const error    = document.getElementById('login-error')
        error.style.display = 'none'

        fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
        }).then(res => {
            if (res.status === 200) {
                document.location.href = '/'
            } else {
                error.textContent = 'Incorrect username or password.'
                error.style.display = 'block'
            }
        })
    }
</script>
</html>
