<!DOCTYPE html>
<html>
<%= erb :_head %>
<body class="centered">
    <section>
        <div class="flex-col gap">
            <div class="flex-col" style="align-items: center; gap: var(--padding);">
                <img src="/images/search.gif" style="object-fit: none; height: 100%;">
                <p>Welcome to Louis' CDN!</p>
            </div>
            <input id="username" style="border: var(--border-width) ridge var(--border);" placeholder="Username" autocomplete="username">
            <input id="password" style="border: var(--border-width) ridge var(--border);" placeholder="Password" type="password" autocomplete="current-password">
        </div>
        <div id="login-error" class="mt" style="color: var(--bad);"></div>
        <div class="buttons mt" style="justify-content: center;">
            <button class="blink" onclick="window.location = '/help'">Help</button>
            <button class="glink" onclick="submitAttempt()">Log in</button>
        </div>
    </section>
</body>

<script>
    document.getElementById('password').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') submitAttempt()
    })

    let submitAttempt = () => {
        const username = document.getElementById('username').value
        const password = document.getElementById('password').value
        const error    = document.getElementById('login-error')
        error.style.display = 'none'

        fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
        }).then(res => {
            if (res.status === 200) {
                document.location.href = '/'
            } else {
                error.textContent = 'Incorrect username or password.'
                error.style.display = 'block'
            }
        })
    }
</script>
</html>
